{
  "name": "functions",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "rimraf lib && npm run genruntimeconfig && tsc",
    "commit": "git-cz",
    "serve": "tsc && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions --project bullion-vs-bytes",
    "logs": "firebase functions:log",
    "test": "jest",
    "watch": "tsc --watch",
    "genruntimeconfig": "firebase functions:config:get > .runtimeconfig.json",
    "emulator": "yarn build && firebase emulators:start --only functions",
    "debug": "yarn emulator --inspect-functions"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.6.2",
    "firebase": "^10.8.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.6.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.168",
    "@types/node": "^20.5.9",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "2.5.1",
    "rimraf": "^3.0.2",
    "typescript": "^4.1.0"
  },
  "private": true,
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,ts,md}": "prettier --write"
  }
}
